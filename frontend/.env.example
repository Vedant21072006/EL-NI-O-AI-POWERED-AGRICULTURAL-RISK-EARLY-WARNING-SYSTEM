# KrishiAlert Frontend Environment Variables

# When deploying frontend and backend to different domains,
# specify the full URL of your deployed backend (e.g. on Render, Railway, Cloud Run):
# Example: VITE_API_BASE_URL=https://krishialert-api.onrender.com
VITE_API_BASE_URL=

# Local dev proxy target (defaults to http://localhost:5000 if not set)
VITE_API_PROXY_TARGET=http://localhost:5000
